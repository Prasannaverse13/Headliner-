QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
OPENAI_API_KEY=
# Cheap model used by the agent (the 'luna' model on this account).
OPENAI_MODEL=gpt-5.6-luna

# Optional but recommended on Vercel: keeps saved demo plans across cold starts.
# Create a free Redis database at https://upstash.com and paste the REST values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
